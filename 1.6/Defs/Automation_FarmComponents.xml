<RecipeDef>
  <defName>PC_Make_FarmFrame</defName>
  <label>make farm frame</label>
  <description>Assemble a reinforced steel chassis frame for automated farm machines.</description>
  <jobString>Making farm frame.</jobString>
  <workAmount>800</workAmount>
  <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
  <effectWorking>Smith</effectWorking>
  <soundWorking>Recipe_Machining</soundWorking>
  <ingredients>
    <li>
      <filter>
        <thingDefs>
          <li>Steel</li>
        </thingDefs>
      </filter>
      <count>40</count>
    </li>
  </ingredients>
  <fixedIngredientFilter>
    <thingDefs>
      <li>Steel</li>
    </thingDefs>
  </fixedIngredientFilter>
  <products>
    <PC_FarmFrame>1</PC_FarmFrame>
  </products>
  <recipeUsers>
    <!-- 原版 defName 是 TableMachining（不是 MachiningTable）；原版 recipeUsers 亦用此写法 -->
    <li>TableMachining</li>
    <li>FabricationBench</li>
  </recipeUsers>
  <researchPrerequisite>PC_Research_AutomationBasics</researchPrerequisite>
</RecipeDef>

