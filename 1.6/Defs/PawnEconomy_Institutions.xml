  <JobDef>
    <defName>PC_PEA_Visit</defName>
    <driverClass>PersonalChronicle.Economy.PawnEconomy.JobDriver_EconomicVisit</driverClass>
    <reportString>前往经济机构办理服务。</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>
  <JobDef>
