<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DesignationCategoryDef>
    <defName>PC_PEA_Institutions</defName>
    <label>经济机构</label>
    <order>510</order>
  </DesignationCategoryDef>
  <ThingDef Name="PC_PEA_CounterBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>PersonalChronicle.Economy.PawnEconomy.Building_EconomyInstitution</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(2,2)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    <uiIconScale>1</uiIconScale>
    <size>(1,2)</size>
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <drawerType>MapMeshAndRealTime</drawerType>
    <designationCategory>PC_PEA_Institutions</designationCategory>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Mass>15</Mass>
      <Flammability>1</Flammability>
    </statBases>
    <costList>
      <WoodLog>40</WoodLog>
      <Steel>15</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
    </building>
  </ThingDef>
  <ThingDef ParentName="PC_PEA_CounterBase">
    <defName>PC_PEA_LaborOffice</defName>
    <label>劳务站</label>
    <description>殖民者经济服务柜台。通过“经济机构”管理账户、岗位、真实库存与服务；需要在管理界面启用经济系统。</description>
    <graphicData>
      <texPath>Things/Building/PawnEconomy/PC_PEA_LaborOffice</texPath>
    </graphicData>
    <uiIconPath>Things/Building/PawnEconomy/PC_PEA_LaborOffice_north</uiIconPath>
    <modExtensions>
      <li Class="PersonalChronicle.Economy.PawnEconomy.EconomyInstitutionExtension">
        <kind>LaborOffice</kind>
      </li>
    </modExtensions>
  </ThingDef>
