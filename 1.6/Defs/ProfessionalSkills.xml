<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    P2 垂直切片：制造类 → 精密制造 → 加工/质控能力 → XP → 等级（V2.0 §23 第一条验收闭环）。
    基线：P2-A 领域设计（docs/设计文档/功能模块/职业档案/制造类职业领域设计.md）。
    Q2/Q3/Q4 决策：首技能=精密制造；maxLevel=50 / xpPerPracticeBase=10；精密相关 2~3 Recipe。

    原版 RecipeDef 核验（RimWorld 1.6，Recipes_Production.xml）：
      Make_ComponentIndustrial  = 工业组件（Crafting 8, workAmount 5000）
      Make_ComponentSpacer      = 太空组件（Crafting 8, workAmount 10000）
    旧版 Make_Component/Make_AdvancedComponent 在 1.6 已不存在，勿用。

    翻译键约定：PersonalChronicle.Professional.Skill.<defName>.Label / .Desc 经 Def 派生；
    Def 内不写硬编码 label，由 Languages/Archive.xml 提供。
  -->

  <!-- ===================== 二级方向：制造类 4 方向（2026-08-19 差异化特化点） =====================
       每个方向携带特化点语义（specializationKey）与说明（specializationDescKey），
       方向间差异由 特化定位 + 技能级效果覆盖（effectOverrides）+ 能力权重 + 成长曲线 共同拉开。
       数据蓝图见 docs/设计文档/功能模块/职业档案/制造类职业领域设计.md §9 差异化特化点。
       方向 label 走动态翻译键 PersonalChronicle.Profession.Direction.<defName>.Label（Languages/Archive.xml）。
  -->
  <PersonalChronicle.Domain.Profession.ProfessionalDirectionDef>
    <defName>Manufacturing_Precision</defName>
    <profession>Manufacturing</profession>
    <skillDefNames>
      <li>ProfessionalSkill_PrecisionManufacturing</li>
    </skillDefNames>
    <colorHex>#e0c77a</colorHex>
    <labelKey>PersonalChronicle.Profession.Direction.Manufacturing_Precision.Label</labelKey>
    <specializationKey>Quality</specializationKey>
    <specializationDescKey>PersonalChronicle.Profession.Direction.Manufacturing_Precision.Specialization</specializationDescKey>
    <order>0</order>
  </PersonalChronicle.Domain.Profession.ProfessionalDirectionDef>

