<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Work intensity is Def-driven. External mods may XML-patch the policy or
    add/replace tiers without referencing PersonalChronicle implementation
    classes. Labels/tags are translation keys, never save data.
  -->
  <PersonalChronicle.Domain.WorkIntensityPolicyDef>
    <defName>PersonalChronicleWorkIntensityPolicy</defName>
    <minimumSampleDays>5</minimumSampleDays>
    <overloadRatio>1.5</overloadRatio>
    <slackRatio>0.5</slackRatio>
    <tierDefNames>
      <li>PersonalChronicleWorkIntensityT0</li>
      <li>PersonalChronicleWorkIntensityT1</li>
      <li>PersonalChronicleWorkIntensityT2</li>
      <li>PersonalChronicleWorkIntensityT3</li>
      <li>PersonalChronicleWorkIntensityT4</li>
    </tierDefNames>
  </PersonalChronicle.Domain.WorkIntensityPolicyDef>

  <PersonalChronicle.Domain.WorkIntensityTierDef>
    <defName>PersonalChronicleWorkIntensityT0</defName>
    <tierKey>ReactorMule</tierKey>
    <displayCode>T0</displayCode>
    <minimumDailyHours>12</minimumDailyHours>
    <labelKey>PersonalChronicle.UI.IntensityTier.ReactorMule</labelKey>
    <tagKey>PersonalChronicle.UI.IntensityTag.ReactorMule</tagKey>
    <colorHex>#D85A30</colorHex>
    <order>0</order>
  </PersonalChronicle.Domain.WorkIntensityTierDef>

  <PersonalChronicle.Domain.WorkIntensityTierDef>
