<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    工业员工岗位表（CHG-20261004-STAFF · 玩家口径「车间工作类型改为【员工】，这是一套现代化工业岗位体系」）。

    ★ 定位（2026-10-04 玩家裁决）
      这不是"某个车间的岗位表"，而是**一套现代化的工业岗位体系**：
      员工岗位是全公司通用的组织角色，挂在哪个车间、承接哪些工序由排班决定。

    ★ 两个字段必须分清（接管安全的闸门）
      coveredWorkTypeDefNames      能力声明：这个员工**将来**要承接什么（规划表，可写全）
      implementedWorkTypeDefNames  已交付：车间里**真的已经有 Job** 在做（接管只认这个）
      生产岗位现在调度原版工单，其他岗位仍复用原版服务；待命每 300 tick 重查。
      => 未交付独立替代服务，implemented 仍为空 => 不接管清零原版工作。

    ★ 归属规则（2026-10-04 修正）
      旧版把操作员写成 Crafting…Construction 的**"全集上界"**，导致 Research 被误覆盖
      => 能力对等闸门误判 => 科技停滞。现改为**每个原版工作类型只归属一个员工**。

    ★ 硬红线（EXC-2026-016，永不接管）
      Hauling / Cleaning / Doctor / Firefighter 不归属任何员工：
      无人搬运=>断料停摆；无人清洁=>脏乱生病；无人医治=>伤亡；无人灭火=>火灾失控。

    ★ 身份类（非工种，不进车间）
      Patient / PatientBedRest 是"当前身份"；BasicWorker 是原版杂项兜底；Warden 与生产无关。

    兼容：既有 9 个岗位的 defName / postKey 一律不动（存档存的是 postKey），只改 label 与 covered。
  -->

  <!-- ① 操作员工：生产主力。手工/锻造/烹饪/裁缝/艺术。 -->
  <PersonalChronicle.Automation.WorkshopPostDef>
    <defName>WP_Operator</defName>
    <label>操作员工</label>
    <postKey>Operator</postKey>
    <dutyTaskTypeKey>Production</dutyTaskTypeKey>
    <coveredWorkTypeDefNames>
      <li>Crafting</li>
      <li>Smithing</li>
      <li>Cooking</li>
      <li>Tailoring</li>
      <li>Art</li>
    </coveredWorkTypeDefNames>
    <implementedWorkTypeDefNames/>
    <skillDefNames>
      <li>Crafting</li>
      <li>Smithing</li>
      <li>Cooking</li>
      <li>Tailoring</li>
      <li>Artistic</li>
    </skillDefNames>
    <minSkillLevel>0</minSkillLevel>
    <requiredCapacityDefNames>
      <li>Manipulation</li>
    </requiredCapacityDefNames>
    <deliversOwnService>false</deliversOwnService>
    <!-- CHG-20261005-DUTYRUNTIME：用户批准岗位实装，操作员工参与原版工作落地。 -->
    <landingExempt>false</landingExempt>
    <notes>生产主力岗。**Research / PlantCutting / Construction 已移出本岗**（旧版当"全集上界"写在这里，导致 Research 被误判为车间可独立交付 =&gt; 科技停滞）。生产岗位已接入原版工单，参与岗位落地；仍需人工操作，未交付独立替代服务，因此不接管原版工作。</notes>
  </PersonalChronicle.Automation.WorkshopPostDef>

  <!-- ② 设备技术员工：建造与维修。 -->
  <PersonalChronicle.Automation.WorkshopPostDef>
    <defName>WP_Technician</defName>
    <label>设备技术员工</label>
    <postKey>Technician</postKey>
    <dutyTaskTypeKey>Maintenance</dutyTaskTypeKey>
    <coveredWorkTypeDefNames>
      <li>Construction</li>
    </coveredWorkTypeDefNames>
    <implementedWorkTypeDefNames/>
    <skillDefNames>
      <li>Construction</li>
    </skillDefNames>
    <minSkillLevel>0</minSkillLevel>
    <requiredCapacityDefNames>
      <li>Manipulation</li>
    </requiredCapacityDefNames>
    <deliversOwnService>false</deliversOwnService>
    <notes>设备维修保养岗 =&gt; 原版 Construction。Maintenance 已实现并计入工时分档；维修 Job 未实现 ⇒ 暂不接管。</notes>
  </PersonalChronicle.Automation.WorkshopPostDef>

  <!-- ④ 物料员工：Hauling 属硬红线。 -->
  <PersonalChronicle.Automation.WorkshopPostDef>
    <defName>WP_MaterialHandler</defName>
    <label>物料员工</label>
    <postKey>MaterialHandler</postKey>
    <coveredWorkTypeDefNames>
      <li>Hauling</li>
    </coveredWorkTypeDefNames>
    <implementedWorkTypeDefNames/>
    <requiredCapacityDefNames>
      <li>Moving</li>
    </requiredCapacityDefNames>
    <deliversOwnService>false</deliversOwnService>
    <notes>Hauling 是**硬红线**（永不接管）：清零搬运 =&gt; 无人送料 =&gt; 产线停摆。本岗只声明能力。</notes>
  </PersonalChronicle.Automation.WorkshopPostDef>

  <!-- ⑤ 仓储员工：Hauling / Cleaning 均属硬红线。 -->
