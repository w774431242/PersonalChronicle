<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ===================================================================
       车间类型 WorkshopTypeDef —— 基于环世界原版生产设备风格分类（2026-09-25 重定义）
       仅用于「分类 / 设备匹配概览 / 排班 / 专向风格 buff」，不影响原版生产机制。

       字段说明：
         processStage        —— 工序/风格标签（仅用于俯视图着色）。
         skillDefNames      —— 该类型用于「上岗优先级评分」的代表技能（原版 SkillDef）。
         expectedDeviceDefNames —— 原生锚点设备（ThingDef），仅供概览算设备匹配度。
         workSpeedBonusPct  —— 工作速度加成（百分点，10 = +10%），对在岗人员生效。
         qualityBonus       —— 品质加成（档位，1 = +1 品质）。
         researchSpeedBonusPct —— 研究速度加成（百分点，研发车间专用）。
         *WorkTypeDefNames  —— 「岗位 → 原版工作类型」映射（2026-10-02 新增）：
                               班次设置里选定岗位后，原版「工作」面板会自动勾选这里列出的
                               WorkTypeDef，并把它提升到**最高档（1）**，让被排班的成员
                               优先去做车间里的活（而不是站着闲置）。
                               ★ 覆盖规则：0 → 1（含玩家显式关闭后的重开）、2/3/4 → 1；
                                 绝不反向关闭、不重排其它类型。
                               ★ 值勤类型 PC_WorkshopOperation 不在此列、不参与提升
                                 （它只做 Enable，依据 Defs/Automation_WorkType.xml:9-19）。
                               ★ 原版仅在「手动优先级」模式下读取档位 —— 简单模式下只做
                                 Enable 并保持关闭档位写入；管理面板「设置」页有状态行与
                                 一键开启出口。
                                 （EXC-2026-012 受控 Enable + EXC-2026-013 受控档位提升）
                               qualityCheck / standby 原版无对应工作类型 ⇒ 常态留空 = 不联动。

       注（2026-09-26）：加成体系已恢复为「专向风格固定 buff」—— 数值即面板显示数值
       （显示 = 生效，无技能缩放），由 WorkshopBonusResolver 直读本 Def 换算。
       =================================================================== -->

  <!-- ① 伐木坊：木材采集/粗加工（原版无专用台，风格化归类） -->
  <PersonalChronicle.Automation.WorkshopTypeDef>
    <defName>WT_Logging</defName>
    <label>伐木坊</label>
    <description>木材采集与粗加工区域。锚定原版「手工加工点 / 锯木」类作业，按 Plants 技能评估上岗优先级；在坊内作业 +10% 工作速度。</description>
    <processStage>Logging</processStage>
    <skillDefNames>
      <li>Plants</li>
    </skillDefNames>
    <productionWorkTypeDefNames>
      <li>PlantCutting</li>
    </productionWorkTypeDefNames>
    <maintenanceWorkTypeDefNames>
      <li>Construction</li>
    </maintenanceWorkTypeDefNames>
    <processKeys>
      <li>WP_Logging_Production</li>
      <li>WP_Logging_Maintenance</li>
    </processKeys>
    <workSpeedBonusPct>10</workSpeedBonusPct>
  </PersonalChronicle.Automation.WorkshopTypeDef>

