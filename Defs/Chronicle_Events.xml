  </PersonalChronicle.Domain.ChronicleEventDef>

  <PersonalChronicle.Domain.ChronicleEventDef>
    <defName>PersonalChronicleEventBattle</defName>
    <!-- Dead label (UI reads labelKey only) — kept for Def base-class safety. -->
    <label>Battle</label>
    <labelKey>PersonalChronicle.Event.Battle</labelKey>
