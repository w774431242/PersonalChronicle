    { "id": "active", "lane": "rail", "col": 2, "type": "security", "label": "激活判定", "sublabel": "双阈值迟滞", "tag": "布尔式" },
    { "id": "safety", "lane": "rail", "col": 3, "type": "security", "label": "安全线", "sublabel": "Food .35 · Rest .25", "tag": "独立于 active", "width": 124 },
