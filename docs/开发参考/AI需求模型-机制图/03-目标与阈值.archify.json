  "cards": [
    {
      "dot": "emerald",
      "title": "激活式",
      "items": [
        "active = 已知 ∧ ¬frozen ∧ (ratio < 进入线 ∨ (wasActive ∧ ratio < 目标值))",
        "进入用 Enter，退出用目标比率 ⇒ 迟滞，不抖动",
        "安全线（.35 / .25）与 active 独立，命中即 urgent"
      ]
    },
    {
      "dot": "amber",
      "title": "等待与风险",
      "items": [
        "等待加权上限 6000 tick：硬截断；仅 seed/previous 可续算，跨会话从 0 起",
        "非 active 项不累计等待；风险时限由前后周期差分实时估算",
        "slack = 时限 − 帮助时延；不可估或无来源时返回 −1（仍参与排序）"
      ]
    },
    {
      "dot": "rose",
      "title": "与描述不符",
      "items": [
        "不存在 Complete 常量：退出阈值 = 目标比率（.85 / .90 / .70）",
        "不存在风险时限常量：只有 MinimumDrainRatePerTick 兜底",
        "类注释的排序键序与实际代码不符（实际含 slack 两级）"
      ]
    }
  ]
